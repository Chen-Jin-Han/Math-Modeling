{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chengziyue1222/math-model/schemas/run-manifest.schema.json",
  "title": "Math Model Run Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "problem",
    "stage",
    "status",
    "data_inputs",
    "model",
    "execution",
    "parameters",
    "metrics",
    "failed_runs",
    "artifacts",
    "environment",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "parent_run_id": {"type": ["string", "null"]},
    "problem": {
      "type": "object",
      "required": ["competition", "year", "code", "title", "source"],
      "additionalProperties": false,
      "properties": {
        "competition": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 1900},
        "code": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "stage": {
      "enum": ["intake", "analysis", "modeling", "validation", "writing", "review", "release"]
    },
    "status": {"enum": ["running", "succeeded", "failed", "partial"]},
    "data_inputs": {"type": "array", "items": {"$ref": "#/$defs/fileRecord"}},
    "model": {
      "type": "object",
      "required": ["name", "version", "assumptions_path", "parameter_source"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "assumptions_path": {"type": ["string", "null"]},
        "parameter_source": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object",
      "required": ["command", "deterministic", "random_seeds", "git_commit", "git_dirty"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "deterministic": {"type": "boolean"},
        "random_seeds": {"type": "object", "additionalProperties": {"type": "integer"}},
        "git_commit": {"type": ["string", "null"]},
        "git_dirty": {"type": ["boolean", "null"]}
      }
    },
    "parameters": {"type": "object"},
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "unit", "split"],
        "properties": {
          "value": {"type": "number"},
          "unit": {"type": "string"},
          "split": {"type": "string"}
        }
      }
    },
    "failed_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "reason"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "diagnostics_path": {"type": ["string", "null"]}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/fileRecord"},
          {"type": "object", "required": ["role"], "properties": {"role": {"type": "string", "minLength": 1}}}
        ]
      }
    },
    "environment": {
      "type": "object",
      "required": ["python", "platform", "dependencies"],
      "properties": {
        "python": {"type": "string"},
        "platform": {"type": "string"},
        "dependencies": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "fileRecord": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
